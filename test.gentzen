inbyte : () / ($1(iosys) |- $2(|\|));

outbyte : () / ($1(iosys), $2(|\|) |- $3(++));

outtext : () / ($1(iosys), $2(.. |\|) |- $3(++));
outtext = [io,s,z] cut true [t] fold s t z [ch,_,k] outbyte io ch k;

helloworld : () / (|- $1(.. |\|));

main : () / ($1(iosys) |- $2(++));
main = [x,y] cut helloworld [z] outtext x z y;
