<- "stdlib";

lem : () / (|- $1(?x), $2(~ ?x));
lem = [out, k] init k out;

notL : (*a |- $1(?x), *b) / ($1(~?x), *a |- *b);
notL = [f / i] f i;

notR : ($1(?x), *a |- *b) / (*a |- $1(~?x), *b);
notR = [f / o] f o;

dne : () / ($1(~ ~ ?x) |- $2(?x));
dne = [kk, out] notR kk [k2] init k2 out;

-> lem notL notR dne;
