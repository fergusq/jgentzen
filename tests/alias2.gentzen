<- "stdlib";
<- "iolib";

nat := ++ \/ nat;

zero : () / (|- $1(nat));
zero = [out] left/or out [u] true u;

two : () / (|- $1(nat));
two = [out] right/or out [n1] right/or n1 [n0] zero n0;

make_pair : () / ($1(?a), $2(?b) |- $3(?a /\ ?b));
make_pair = [a, b, pair]
    split/and pair
        ([left] init a left)
        ([right] init b right);

add : () / ($1(nat), $2(nat) |- $3(@ nat));
add = [a, b, out]
    cut ([o] make_pair a b o) [pair]
    loop pair out [cur, next, done]
    left/and cur [cur_a]
    right/and cur [cur_b]
    split/or cur_a
        ([_] init cur_b done)
        ([pred] cut ([o1] right/or o1 ([o2] init cur_b o2)) [succ]
                cut ([o] make_pair pred succ o) [new_pair]
                init new_pair next);


drain_nat : (*a |- $1(++), *b) / ($1(nat), *a |- $2(@ ++), *b);
drain_nat = [f / n, out]
    loop n out [cur, next, done]
    split/or cur
        ([_] true done)
        ([m] cut f [_] init m next);

out_star : () / ($1(iosys) |- $2(++));
out_star = [io, done]
    cut '*' [star]
    outbyte io star done;

main : () / ($1(iosys) |- $2(@ ++));
main = [io, done]
    cut two [t1]
    cut two [t2]
    cut ([o] add t1 t2 o) [sum]
    lcopy sum done [inner_sum, _]
    drain_nat inner_sum done ([out] out_star io out);

-> nat zero two make_pair add drain_nat out_star;
